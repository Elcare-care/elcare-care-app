// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  Active
  Sold
  Cancelled
  Auction
}

enum AuctionStatus {
  Active
  Finalized
  Cancelled
}

enum OfferStatus {
  Pending
  Accepted
  Rejected
  Withdrawn
  Reclaimed
}

/// Tracks per-bid refund eligibility for `refund_losing_bid` (Issue #466).
enum BidRefundStatus {
  /// Default: refund eligibility not yet determined (auction still Active).
  None
  /// The auction has settled; this losing bid is eligible for `refund_losing_bid`.
  Refundable
  /// The bidder has successfully claimed their refund via `refund_losing_bid`.
  Claimed
}

model SyncState {
  id               Int      @id @default(1)
  lastLedger       Int      @default(0)
  lastLedgerHash   String?
  updatedAt        DateTime @updatedAt
}

// ── Dynamic contract registry ─────────────────────────────────────────────────
//
// Each row represents one Soroban contract being tracked by the indexer.
// type: "marketplace" | "launchpad"
// lastLedger/lastLedgerHash track per-contract sync progress independently.

model TrackedContract {
  id               Int      @id @default(autoincrement())
  contractId       String   @unique
  type             String   // "marketplace" | "launchpad"
  label            String   @default("")
  startLedger      Int      @default(0)
  lastLedger       Int      @default(0)
  lastLedgerHash   String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active])
  @@index([type])
}

model Listing {
  listingId       BigInt        @id
  artist          String
  owner           String?
  price           Decimal       @db.Decimal(32, 7)
  currency        String
  collection      String
  nftTokenId      BigInt
  token           String
  status          ListingStatus @default(Active)
  recipients      Json?
  createdAtLedger Int
  updatedAtLedger Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // ── Royalty fields ─────────────────────────────────────────────────────────
  /// Address of the original creator — used to attribute secondary royalties
  /// after ownership has transferred.
  originalCreator String?
  /// Collection-level royalty in basis points (0–10 000).
  royaltyBps      Int           @default(0)

  // ── Full-text search fields (populated from IPFS metadata after indexing) ──
  // Populated asynchronously after a LISTING_CREATED event is processed.
  // Null until IPFS metadata has been fetched and stored.
  title           String?
  description     String?
  artistName      String?
  // tsvector updated by the listing_search_vector_trigger in PostgreSQL.
  // Prisma cannot manage this column natively; it is marked Unsupported so
  // Prisma skips it in generated client writes — all updates go through the
  // trigger or raw SQL.
  searchVector    Unsupported("tsvector")?

  @@index([artist])
  @@index([status])
  @@index([updatedAtLedger])
  @@index([status, updatedAtLedger])
  @@index([artist, updatedAtLedger])
  @@index([collection])
  @@index([collection, status])
  @@index([originalCreator])
  // GIN index created via raw SQL in the migration (Prisma cannot express it).
  // CREATE INDEX "Listing_searchVector_idx" ON "Listing" USING gin("searchVector");
}

model Auction {
  auctionId       BigInt        @id
  creator         String
  collection      String
  nftTokenId      BigInt
  token           String
  reservePrice    Decimal       @db.Decimal(32, 7)
  highestBid      Decimal       @db.Decimal(32, 7)
  highestBidder   String?
  endTime         BigInt
  status          AuctionStatus @default(Active)
  recipients      Json?
  createdAtLedger Int
  updatedAtLedger Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  /// Running count of extensions applied so far (from AuctionExtended events)
  extensionCount  Int           @default(0)
  /// Original end time set at auction creation, used to enforce total duration cap
  originalEndTime BigInt
  /// Snapshotted max-extensions cap from auction creation (0 = unlimited). Issue #468.
  maxExtensions   Int           @default(0)
  @@index([updatedAtLedger])
  @@index([status, updatedAtLedger])
  @@index([creator, updatedAtLedger])
}

model Offer {
  offerId         BigInt      @id
  listingId       BigInt
  offerer         String
  amount          Decimal     @db.Decimal(32, 7)
  token           String
  status          OfferStatus @default(Pending)
  /// Optional expiry (ledger timestamp) after which the offer can be reclaimed. Null = never expires.
  expiresAt       BigInt?
  /// Soroban tx hash of the escrow deposit (set from the OFFER_MADE event). Null until indexed.
  escrowTxHash    String?
  /// Soroban tx hash of the terminal payout/refund (accept, reject, withdraw, or reclaim). Null until indexed.
  refundTxHash    String?
  /// Issue #528 groundwork: offerId of the offer this one counters, when the
  /// (not-yet-built) counter-offer flow creates one. Always null today.
  parentOfferId   BigInt?
  createdAtLedger Int
  updatedAtLedger Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@index([listingId])
  @@index([listingId, updatedAtLedger])
  @@index([parentOfferId])
}

// ── Token whitelist registry (Issue #208) ─────────────────────────────────
//
// Tracks all tokens ever added to the whitelist with full audit trail.
// Soft delete pattern: removed tokens have active=false but remain in the table.

model WhitelistedToken {
  address         String   @id
  active          Boolean  @default(true)
  addedAtLedger   Int
  removedAtLedger  Int?
  addedBy         String
  removedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
  @@index([addedAtLedger])
}

model Bid {
  id              Int             @id @default(autoincrement())
  auctionId       BigInt
  bidder          String
  amount          Decimal         @db.Decimal(32, 7)
  ledgerSequence  Int
  createdAt       DateTime        @default(now())
  /// Refund eligibility state populated from AUCTION_BID_REFUNDED events (Issue #466).
  refundStatus    BidRefundStatus @default(None)
  @@index([auctionId])
  @@index([bidder])
  @@index([ledgerSequence])
  @@index([auctionId, refundStatus])
  @@unique([auctionId, ledgerSequence, bidder])
}

model MarketplaceEvent {
  id              Int      @id @default(autoincrement())
  listingId       BigInt?
  eventType       String   // "LISTING_CREATED", "ARTWORK_SOLD", etc.
  actor           String
  data            Json
  ledgerSequence  Int
  ledgerTimestamp DateTime @default(now())
  /// Canonical event identity: SHA256(contractId:ledger:txHash:eventIndex).
  /// NULL only for legacy rows ingested before this field was introduced.
  eventHash       String?  @unique               // nullable — no @default("") to prevent degenerate collisions
  contractId      String   @default("")          // source contract address
  /// Issue #286: provisional (false) vs confirmed (true) event state.
  /// Events are promoted to confirmed once they are CONFIRMATION_DEPTH ledgers
  /// behind the network tip.  On reorg, events past the safe ledger are
  /// hard-deleted (provisional by definition).
  confirmed       Boolean  @default(false)
  /// Issue #532: position of this event within its ledger transaction, used
  /// for deterministic same-ledger ordering in the provenance timeline.
  /// NULL for legacy rows ingested before this field was introduced.
  eventIndex      Int?
  @@index([actor])
  @@index([eventType])
  @@index([listingId])
  @@index([ledgerSequence])
  @@index([listingId, ledgerSequence])
  @@index([contractId])
  @@index([actor, ledgerSequence])
  @@index([contractId, ledgerSequence])
  // Issue #532: composite index for provenance timeline ordering
  @@index([ledgerSequence, eventIndex])
  @@unique([listingId, eventType, ledgerSequence])
}

/// One row per recipient per settled sale, sourced from ROYALTY_PAID events.
/// Exactly one of listingId / auctionId is set, mirroring the on-chain event.
model RoyaltyPayment {
  id             Int      @id @default(autoincrement())
  listingId      BigInt?
  auctionId      BigInt?
  recipient      String
  amount         Decimal  @db.Decimal(32, 7)
  salePrice      Decimal  @db.Decimal(32, 7)
  ledgerSequence Int
  createdAt      DateTime @default(now())
  @@index([recipient])
  @@index([ledgerSequence])
  @@index([recipient, ledgerSequence])
}

model Collection {
  id              Int      @id @default(autoincrement())
  contractAddress String   @unique
  kind            String   // "normal_721" | "normal_1155" | "lazy_721" | "lazy_1155"
  creator         String
  name            String?
  symbol          String?
  deployedAtLedger Int
  /// Per-collection protocol fee override in basis points (0–10 000).
  /// Null means no override is set and the global protocol fee applies.
  feeBpsOverride  Int?
  /// Whether the collection metadata has been permanently frozen.
  metadataFrozen  Boolean  @default(false)
  /// Metadata validation status (Issue #476).
  /// "valid"   — deployed after #476 validation rules; all fields passed launchpad checks.
  /// "unknown" — deployed before #476; no validation guarantee.
  metadataStatus  String   @default("unknown")
  createdAt       DateTime @default(now())
  // GIN-indexed tsvector updated by collection_search_vector_trigger.
  searchVector    Unsupported("tsvector")?
  @@index([creator])
  @@index([creator, deployedAtLedger])
  @@index([kind, deployedAtLedger])
}

// ── Lazy-mint voucher registry ────────────────────────────────────────────────
//
// Tracks voucher issuance, redemption, and revocation for lazy-mint collections.
// Indexed per collection so the API can serve filtered voucher lists with pagination.

model Voucher {
  id              Int      @id @default(autoincrement())
  collection      String   // collection contract address
  nonce           BigInt   // unique per-voucher nonce (replay-protection key)
  tokenId         BigInt?  // target token id (may be null until redeemed)
  status          String   @default("Issued") // Issued | Redeemed | Revoked | Expired
  redeemer        String?  // address that redeemed (null if not yet redeemed)
  createdAtLedger Int
  updatedAtLedger Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([collection, nonce])
  @@index([collection])
  @@index([collection, status])
  @@index([createdAtLedger])
}

// ── IPFS metadata cache ───────────────────────────────────────────────────────
//
// Content-addressed metadata cache keyed by IPFS CID.  Populated by the
// background IpfsQueue worker once content is fetched from a gateway.
// Prisma cannot express the raw JSON `raw` field as anything other than Json,
// so callers must cast it to `Record<string, unknown>` when reading artist info.

model IpfsMetadata {
  cid         String   @id
  title       String?
  description String?
  imageUrl    String?
  attributes  Json?
  fetchedAt   DateTime @default(now())
  raw         Json
}

// ── IPFS fetch queue ──────────────────────────────────────────────────────────
//
// Durable background job queue for fetching and caching IPFS content.
// Workers poll for Pending/Failed entries with nextRetryAt <= now().

model IpfsQueue {
  id          Int       @id @default(autoincrement())
  cid         String
  attempts    Int       @default(0)
  nextRetryAt DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([cid])
}

// ── Backfill subsystem ───────────────────────────────────────────────────────
//
// BackfillJob tracks a single bounded historical scan.  Progress is
// check-pointed per batch so a crash can resume from checkpointLedger.
//
// Lifecycle:
//   Pending → Running → Completed
//                     → Failed  (retryable via --resume=<id>)
//   Cancelled         (operator-cancelled before or during run)
//
// advisoryLock: Postgres pg_try_advisory_lock(id) key stored here so two
//               workers cannot claim the same job concurrently.

enum BackfillJobStatus {
  Pending
  Running
  Completed
  Failed
  Cancelled
}

enum LedgerGapSource {
  rpc_window_skip   // poller advanced past the RPC retention window
  reorg             // chain reorg caused a gap
  manual            // operator-created gap for re-processing
}

enum LedgerGapStatus {
  Open       // discovered, not yet repaired
  Repairing  // a BackfillJob is actively working this gap
  Repaired   // fully covered
  Failed     // repair exhausted retries
}

model BackfillJob {
  id                Int               @id @default(autoincrement())
  startLedger       Int
  endLedger         Int
  checkpointLedger  Int               @default(0)  // last batch end written to DB
  status            BackfillJobStatus @default(Pending)
  rpcUrl            String
  error             String?
  totalInserted     Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // A job may be created to repair a specific gap
  gap               LedgerGap?        @relation(fields: [gapId], references: [id])
  gapId             Int?

  @@index([status])
  @@index([startLedger, endLedger])
  @@index([gapId])
}

model LedgerGap {
  id          Int             @id @default(autoincrement())
  fromLedger  Int
  toLedger    Int
  source      LedgerGapSource
  status      LedgerGapStatus @default(Open)
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // The repair job assigned to cover this gap (null until repair starts)
  repairJob   BackfillJob[]

  @@index([status])
  @@index([fromLedger, toLedger])
  @@unique([fromLedger, toLedger, source])  // prevent duplicate gap rows
}

// ── Ledger Checkpoint subsystem ───────────────────────────────────────────────
//
// A LedgerCheckpoint records the state of a single polling window for one
// tracked contract.  The lifecycle is:
//   fetched   → Window data retrieved from Stellar RPC; events not yet written.
//   applying  → DB transaction that writes domain rows is open.
//   committed → Transaction committed; cursor is now at windowEnd.
//   failed    → Window application failed after all retries.
//
// The cursor on TrackedContract is ONLY advanced inside the same transaction
// that commits the domain writes (applying → committed).  On restart the
// poller queries for any checkpoint in "fetched" or "applying" state and
// replays those windows.  Because all event upserts are idempotent (eventHash
// unique constraint) a replay is always safe.

enum CheckpointStatus {
  fetched    // events retrieved from RPC; domain writes not started
  applying   // DB transaction open; cursor not yet advanced
  committed  // transaction committed; cursor reflects windowEnd
  failed     // unrecoverable error; operator action required
}

model LedgerCheckpoint {
  id              Int              @id @default(autoincrement())
  contractId      String           // TrackedContract.contractId
  windowStart     Int              // first ledger in the batch
  windowEnd       Int              // last ledger in the batch
  ledgerHash      String?          // hash of windowEnd ledger (for continuity)
  eventCount      Int              @default(0)
  status          CheckpointStatus @default(fetched)
  error           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([contractId, status])
  @@index([status])
  @@index([contractId, windowEnd])
}

// ── Keeper subsystem ──────────────────────────────────────────────────────────
//
// Records every maintenance action the keeper attempts so that restarts never
// double-submit a pending on-chain transaction.  The lifecycle is:
//   Pending → Submitted → Succeeded
//                       → Failed (retryable)
//                       → Skipped (permanent — e.g. ListingNotExpired contract revert)
//
// targetType: "ExpireListing" | "FinalizeAuction" | "ReclaimOffer"
// targetId  : the listing_id / auction_id / offer_id (BigInt for parity with the
//             other models)

enum KeeperActionStatus {
  Pending    // Discovered but not yet submitted
  Submitted  // Transaction sent; polling for result
  Succeeded  // getTransaction confirmed success
  Failed     // All retries exhausted; lastError is set
  Skipped    // Permanent contract-level rejection (no resubmission)
}

enum KeeperTargetType {
  ExpireListing
  FinalizeAuction
  ReclaimOffer
}

// ── Price history (Issue #213) ────────────────────────────────────────────────
//
// One row per ListingPriceUpdatedEvent.  Populated by the indexer whenever
// update_listing or update_listing_price emits that event, giving collectors
// a complete, auditable record of every price change for a listing.

model PriceHistory {
  id               Int      @id @default(autoincrement())
  listingId        BigInt
  oldPrice         Decimal  @db.Decimal(32, 7)
  newPrice         Decimal  @db.Decimal(32, 7)
  changedBy        String   @default("")
  changedAtLedger  Int
  changedAt        DateTime @default(now())

  @@index([listingId])
  @@index([listingId, changedAtLedger])
}

model KeeperAction {
  id          Int                 @id @default(autoincrement())
  targetType  KeeperTargetType
  targetId    BigInt
  txHash      String?
  status      KeeperActionStatus  @default(Pending)
  attempts    Int                 @default(0)
  lastError   String?
  feePaid     BigInt?             // in stroops; set on Succeeded
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([targetType, targetId])   // idempotency: one live record per target
  @@index([status])
  @@index([targetType, status])
  @@index([updatedAt])
}

// ── Dead-letter storage (#287) ────────────────────────────────────────────────
//
// Stores every event that the parser or domain-application layer fails to
// process.  Operators can inspect records and replay them after a parser fix
// using the dead-letter-replay CLI (src/dead-letter-replay.ts).
//
// rawTopics / rawValue are bounded at write time (max 512 / 2000 chars each).
// errorMessage is truncated to 1000 chars and stack-frame paths are redacted.

enum DeadLetterStatus {
  Pending   // awaiting replay
  Replayed  // successfully re-processed after a parser fix
  Failed    // replay exhausted attempts; needs manual review
}

model DeadLetterEvent {
  id             Int              @id @default(autoincrement())
  network        String           @default("")
  contractId     String
  ledgerSequence Int
  txHash         String
  eventIndex     Int
  rawTopics      Json
  rawValue       String           @default("")
  errorCode      String           // "SCHEMA_DECODE" | "UNKNOWN"
  errorMessage   String
  parserVersion  String           @default("")
  status         DeadLetterStatus @default(Pending)
  attempts       Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([contractId, ledgerSequence, txHash, eventIndex])
  @@index([status])
  @@index([contractId, ledgerSequence])
  @@index([createdAt])
}

// ── Reconciliation repairs (#288) ─────────────────────────────────────────────
//
// Audit trail for every field-level correction the reconciler applies.
// Preserves oldValue so corrections are reversible and the history is auditable.
// DryRun rows are written in dry-run mode so operators can preview changes.

enum RepairStatus {
  Applied  // correction written to the DB
  DryRun   // would-be correction (dry-run mode; DB not modified)
  Failed   // repair attempted but failed
}

model ReconciliationRepair {
  id           Int          @id @default(autoincrement())
  modelType    String       // "listing" | "auction" | "offer" | "collection"
  recordId     String       // stringified BigInt / Int primary key
  field        String       // e.g. "status", "price", "highestBid"
  oldValue     String
  newValue     String
  reason       String       // e.g. "chain_status_mismatch"
  sourceLedger Int
  status       RepairStatus @default(Applied)
  createdAt    DateTime     @default(now())

  @@index([modelType, recordId])
  @@index([createdAt])
}

// ── Reconciliation run tracking + discrepancies ───────────────────────────────
//
// ReconciliationRun captures per-run metadata so operators can audit health.
// Discrepancy stores every field-level mismatch found; resolvedAt is set when
// auto-repair corrects the row in the same run.

model ReconciliationRun {
  id                  Int           @id @default(autoincrement())
  startedAt           DateTime      @default(now())
  completedAt         DateTime?
  sampledListings     Int           @default(0)
  sampledAuctions     Int           @default(0)
  sampledOffers       Int           @default(0)
  sampledCollections  Int           @default(0)
  discrepanciesFound  Int           @default(0)
  repairsApplied      Int           @default(0)
  skippedRecords      Int           @default(0)
  dryRun              Boolean       @default(false)
  errorMessage        String?
  discrepancies       Discrepancy[]

  @@index([startedAt])
}

model Discrepancy {
  id           Int               @id @default(autoincrement())
  runId        Int
  run          ReconciliationRun @relation(fields: [runId], references: [id])
  kind         String            // "listing" | "auction"
  entityId     String            // listingId / auctionId as string
  field        String            // "status" | "price" | "owner" | "highestBid" | "highestBidder" | "endTime"
  dbValue      String
  chainValue   String
  resolved     Boolean           @default(false)
  detectedAt   DateTime          @default(now())
  resolvedAt   DateTime?

  @@index([runId])
  @@index([kind, entityId])
  @@index([resolved])
  @@index([detectedAt])
}

// ── Archive tables (Issue #295) ────────────────────────────────────────────────
//
// These tables mirror the hot/warm tables and receive rows moved by the
// archival job once they exceed the retention window.  The archive tables are
// append-only; rows are never updated or deleted after insertion.
// Each row carries `archivedAt` and `archiveChecksum` for provenance.

model ArchivedMarketplaceEvent {
  id             Int      @id @default(autoincrement())
  listingId       BigInt?
  eventType       String
  actor           String
  data            Json
  ledgerSequence  Int
  ledgerTimestamp DateTime @default(now())
  eventHash       String?
  contractId      String   @default("")
  confirmed       Boolean  @default(false)
  archivedAt      DateTime @default(now())
  archiveChecksum String

  @@index([ledgerSequence])
  @@index([contractId, ledgerSequence])
  @@index([archivedAt])
}

model ArchivedPriceHistory {
  id              Int      @id @default(autoincrement())
  listingId        BigInt
  oldPrice         Decimal  @db.Decimal(32, 7)
  newPrice         Decimal  @db.Decimal(32, 7)
  changedBy        String   @default("")
  changedAtLedger  Int
  changedAt        DateTime @default(now())
  archivedAt       DateTime @default(now())
  archiveChecksum  String

  @@index([listingId])
  @@index([archivedAt])
}

model ArchivedLedgerCheckpoint {
  id              Int      @id @default(autoincrement())
  contractId      String
  windowStart     Int
  windowEnd       Int
  ledgerHash      String?
  eventCount      Int      @default(0)
  status          String   @default("fetched")
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  archivedAt      DateTime @default(now())
  archiveChecksum String

  @@index([contractId, windowEnd])
  @@index([archivedAt])
}

model ArchivedBackfillJob {
  id               Int      @id @default(autoincrement())
  startLedger      Int
  endLedger        Int
  checkpointLedger Int      @default(0)
  status           String   @default("Pending")
  rpcUrl           String
  error            String?
  totalInserted    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  gapId            Int?
  archivedAt       DateTime @default(now())
  archiveChecksum  String

  @@index([status])
  @@index([archivedAt])
}

model ArchivedLedgerGap {
  id          Int      @id @default(autoincrement())
  fromLedger  Int
  toLedger    Int
  source      String
  status      String   @default("Open")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  archivedAt  DateTime @default(now())
  archiveChecksum String

  @@index([status])
  @@index([archivedAt])
}

model ArchivedDeadLetterEvent {
  id             Int      @id @default(autoincrement())
  network        String   @default("")
  contractId     String
  ledgerSequence Int
  txHash         String
  eventIndex     Int
  rawTopics      Json
  rawValue       String   @default("")
  errorCode      String
  errorMessage   String
  parserVersion  String   @default("")
  status         String   @default("Pending")
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  archivedAt     DateTime @default(now())
  archiveChecksum String

  @@index([status])
  @@index([contractId, ledgerSequence])
  @@index([archivedAt])
}

model ArchivedReconciliationRepair {
  id           Int      @id @default(autoincrement())
  modelType    String   // "listing" | "auction" | "offer" | "collection"
  recordId     String
  field        String
  oldValue     String
  newValue     String
  reason       String
  sourceLedger Int
  status       String   @default("Applied")
  createdAt    DateTime @default(now())
  archivedAt   DateTime @default(now())
  archiveChecksum String

  @@index([modelType, recordId])
  @@index([archivedAt])
}

model ArchivedReconciliationRun {
  id                  Int      @id @default(autoincrement())
  startedAt           DateTime @default(now())
  completedAt         DateTime?
  sampledListings     Int      @default(0)
  sampledAuctions     Int      @default(0)
  discrepanciesFound  Int      @default(0)
  repairsApplied      Int      @default(0)
  skippedRecords      Int      @default(0)
  dryRun              Boolean  @default(false)
  errorMessage        String?
  archivedAt          DateTime @default(now())
  archiveChecksum     String

  @@index([startedAt])
  @@index([archivedAt])
}

model ArchivedDiscrepancy {
  id           Int      @id @default(autoincrement())
  runId        Int
  kind         String
  entityId     String
  field        String
  dbValue      String
  chainValue   String
  resolved     Boolean @default(false)
  detectedAt   DateTime @default(now())
  resolvedAt   DateTime?
  archivedAt   DateTime @default(now())
  archiveChecksum String

  @@index([runId])
  @@index([kind, entityId])
  @@index([archivedAt])
}

model ArchivedKeeperAction {
  id          Int      @id @default(autoincrement())
  targetType  String
  targetId    BigInt
  txHash      String?
  status      String   @default("Pending")
  attempts    Int      @default(0)
  lastError   String?
  feePaid     BigInt?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  archivedAt  DateTime @default(now())
  archiveChecksum String

  @@index([targetType, status])
  @@index([archivedAt])
}

// ── Operational Audit Trail ─────────────────────────────────────────────────────
//
// Append-only audit log for high-risk operational actions. Records cannot be
// edited through the application. Sensitive context is redacted before storage.
// Indexed by actor, action, and timestamp for efficient search and export.
//
// actionType: "admin_role_change" | "recovery_operation" | "cache_invalidation" |
//            "replay_job" | "contract_upgrade" | "emergency_pause" | "data_correction"
// outcome: "success" | "failure" | "partial"
// redactedContext: JSON object with sensitive fields redacted (e.g., secrets, keys)

enum AuditActionType {
  AdminRoleChange
  RecoveryOperation
  CacheInvalidation
  ReplayJob
  ContractUpgrade
  EmergencyPause
  DataCorrection
  BackfillJob
  GapRepair
  DeadLetterReplay
}

enum AuditOutcome {
  Success
  Failure
  Partial
}

model OperationalAudit {
  id              Int           @id @default(autoincrement())
  actor           String        // wallet address or operator identifier
  actionType      AuditActionType
  target          String?       // resource identifier (e.g., listing_id, contract_id)
  requestId       String        // unique request ID for tracing
  outcome         AuditOutcome
  redactedContext Json          // action context with sensitive data redacted
  ipAddress       String?       // client IP address
  userAgent       String?       // client user agent
  createdAt       DateTime      @default(now())

  @@index([actor])
  @@index([actionType])
  @@index([createdAt])
  @@index([actor, actionType])
  @@index([actionType, createdAt])
  @@index([requestId])
}

// ── Financial Reconciliation (Issue #XXX) ───────────────────────────────────────
//
// Tracks financial reconciliation for protocol fees, royalties, sales, and refunds.
// Aggregates are computed per-ledger, per-token, per-collection, and protocol-wide.
// Supports tolerance policies for provisional events and chain timing.

enum FinancialReconcileStatus {
  Pending
  Matched
  DriftDetected
  AlertRaised
  Resolved
}

enum FinancialDriftSeverity {
  Low
  Medium
  High
  Critical
}

model FinancialReconcileRun {
  id                  Int                     @id @default(autoincrement())
  startedAt           DateTime                @default(now())
  completedAt         DateTime?
  ledgerFrom          Int
  ledgerTo            Int
  confirmedDepth      Int                     // confirmation depth used for this run
  toleranceBps        Int                     @default(100) // tolerance in basis points
  includeProvisional  Boolean                 @default(false)
  driftsDetected      Int                     @default(0)
  alertsRaised        Int                     @default(0)
  dryRun              Boolean                 @default(false)
  errorMessage        String?
  drifts              FinancialDrift[]
  
  @@index([startedAt])
  @@index([ledgerFrom, ledgerTo])
}

model FinancialDrift {
  id                  Int                       @id @default(autoincrement())
  runId               Int
  run                 FinancialReconcileRun     @relation(fields: [runId], references: [id])
  
  // Entity identification
  entityType          String                    // "protocol_fee" | "royalty" | "sale" | "refund"
  entityId            String                    // event hash or transaction ID
  ledgerSequence      Int
  
  // Scope dimensions
  token               String?
  collection          String?
  
  // Expected vs actual values
  expectedAmount      Decimal                   @db.Decimal(32, 7)
  actualAmount        Decimal                   @db.Decimal(32, 7)
  driftAmount         Decimal                   @db.Decimal(32, 7)
  driftBps            Int                       // drift in basis points
  
  // Classification
  severity            FinancialDriftSeverity
  status              FinancialReconcileStatus  @default(DriftDetected)
  reason              String                    // e.g., "missing_payout", "duplicate_payout", "wrong_token"
  
  // Provisional handling
  isProvisional       Boolean                    @default(false)
  confirmationDepth   Int?
  
  // Resolution tracking
  resolvedAt          DateTime?
  resolvedBy          String?
  resolutionNotes     String?
  
  detectedAt          DateTime                  @default(now())
  
  @@index([runId])
  @@index([entityType, ledgerSequence])
  @@index([status, severity])
  @@index([token])
  @@index([collection])
  @@index([isProvisional])
  @@index([detectedAt])
}

// Materialized view refresh tracking (managed by application, not Prisma)
model FinancialAggregateSnapshot {
  id                  Int                       @id @default(autoincrement())
  snapshotType        String                    // "per_ledger" | "per_token" | "per_collection" | "protocol"
  scopeKey            String?                   // ledger sequence, token address, or collection address
  ledgerFrom          Int
  ledgerTo            Int
  
  // Aggregated values from events
  protocolFeesTotal   Decimal                   @default(0) @db.Decimal(32, 7)
  royaltiesTotal      Decimal                   @default(0) @db.Decimal(32, 7)
  salesTotal          Decimal                   @default(0) @db.Decimal(32, 7)
  refundsTotal        Decimal                   @default(0) @db.Decimal(32, 7)
  
  // Counts
  protocolFeeCount    Int                       @default(0)
  royaltyCount        Int                       @default(0)
  saleCount           Int                       @default(0)
  refundCount         Int                       @default(0)
  
  // Confirmation state
  confirmedOnly       Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  
  @@unique([snapshotType, scopeKey, ledgerFrom, ledgerTo, confirmedOnly])
  @@index([snapshotType, ledgerFrom, ledgerTo])
  @@index([scopeKey])
}

// ── Projection Rebuild Job ────────────────────────────────────────────────────
//
// Tracks a single resumable projection-rebuild operation initiated by the
// rebuild-projections CLI or admin API.
//
// A rebuild replays canonical MarketplaceEvent rows through the same
// processEvent() projection functions used during live ingestion, updating
// Listing / Auction / Offer / Collection rows from the event log without
// touching the live sync cursor.
//
// Lifecycle:
//   Pending → Running → Completed
//                     → Failed     (retryable via --resume=<id>)
//                     → Cancelled  (operator-cancelled)
//
// Dry-run jobs reach DryRunComplete without modifying domain tables.

enum ProjectionRebuildStatus {
  Pending
  Running
  Completed
  Failed
  Cancelled
  DryRunComplete
}

model ProjectionRebuildJob {
  id                 Int                      @id @default(autoincrement())
  /// Projection types included in this rebuild, e.g. ["listing","auction","offer","collection"]
  projections        String[]
  /// Ledger range lower bound (inclusive). 0 = "from genesis".
  ledgerFrom         Int                      @default(0)
  /// Ledger range upper bound (inclusive). 0 = "to current tip at start time".
  ledgerTo           Int                      @default(0)
  /// Optional filter: rebuild only entities matching this id (BigInt as string).
  entityId           String?
  /// Last fully-processed ledger sequence; 0 before first batch.
  checkpointLedger   Int                      @default(0)
  /// Number of event rows processed so far.
  processedEvents    Int                      @default(0)
  /// Total event rows in scope (estimated at job start; 0 until counted).
  totalEvents        Int                      @default(0)
  /// Number of domain table rows touched (upserted / updated).
  affectedRows       Int                      @default(0)
  /// Number of conflicts detected (rows that would change) in dry-run or execute mode.
  conflictsDetected  Int                      @default(0)
  /// SHA-256 of canonical event hashes before rebuild (hex string, null until computed).
  checksumBefore     String?
  /// SHA-256 of canonical event hashes after rebuild (null until rebuild completes).
  checksumAfter      String?
  status             ProjectionRebuildStatus  @default(Pending)
  dryRun             Boolean                  @default(false)
  /// Whether SSE broadcasts were suppressed during this rebuild.
  sseSuppressed      Boolean                  @default(true)
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([ledgerFrom, ledgerTo])
}
