# @elcarehub/config — Shared Environment Variables
# Copy this file to .env and fill in the required values

# ── Network Configuration ─────────────────────────────────────────────────────

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contract Configuration ────────────────────────────────────────────────────

MARKETPLACE_CONTRACT_ID=
LAUNCHPAD_CONTRACT_ID=

# ── Indexer Configuration ─────────────────────────────────────────────────────

INDEXER_URL=http://localhost:4000
OPERATOR_TOKEN=your-operator-token-minimum-32-characters-long

# Optional: comma-separated IP allowlist for admin endpoints
# OPERATOR_ALLOWLIST=

# ── Database Configuration ────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/database
REDIS_URL=redis://localhost:6379

# ── IPFS Configuration ────────────────────────────────────────────────────────

PINATA_GATEWAY=https://gateway.pinata.cloud
PINATA_JWT=your-pinata-jwt-token

# ── Keeper Configuration ──────────────────────────────────────────────────────

KEEPER_ENABLED=false
KEEPER_DRY_RUN=true
KEEPER_SECRET=your-keeper-secret-key-starting-with-S

# ── Version Metadata ──────────────────────────────────────────────────────────

INDEXER_VERSION=1.0.0
API_VERSION=1.0.0
EVENT_SCHEMA_VERSION=1
DB_MIGRATION_VERSION=20260724000000
