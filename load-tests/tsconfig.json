{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@prisma/client": ["../indexer/node_modules/@prisma/client"]
    }
  },
  "include": ["fixtures/**/*.ts", "ingestion/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
